<Page  
    x:Class="appLauncher.Core.Pages.AppBackgroundSettings"  
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"  
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"  
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"  
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"  
    xmlns:models="using:appLauncher.Core.Model"  
    xmlns:viewmodels="using:appLauncher.Core.ViewModels"  
    xmlns:converters="using:appLauncher.Core.Converters"  
    mc:Ignorable="d"  
    Background="{x:Bind ViewModel.AppBackgroundColorBrush, Mode=OneWay}">  

    <Page.Resources>      
        <DataTemplate x:Key="ImageLIstTemplate" x:DataType="models:PageBackgrounds">  
            <Canvas Background="{x:Bind BackImage, Mode=OneWay}" Height="50" Width="50" Margin="5">  
                <ToolTipService.ToolTip>  
                    <TextBlock Text="{x:Bind BackgroundImageDisplayName, Mode=OneWay}"  
                               Foreground="{x:Bind ViewModel.AppForegroundColorBrush, Mode=OneWay}" />  
                </ToolTipService.ToolTip>  
            </Canvas>  
        </DataTemplate>  
    </Page.Resources>  

    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">  
        <Grid.RowDefinitions>  
            <RowDefinition Height="Auto" />  
            <RowDefinition Height="*" />  
        </Grid.RowDefinitions>  

        <RelativePanel Grid.Row="0" HorizontalAlignment="Stretch" Margin="10" VerticalAlignment="Stretch">  
            <TextBlock Text="Background Image Settings"  
                       FontSize="36"  
                       FontWeight="Bold"  
                       Margin="16,20,0,16"  
                       Name="titleTextBlock"  
                       Foreground="{x:Bind ViewModel.AppForegroundColorBrush, Mode=OneWay}"  
                       RelativePanel.AlignHorizontalCenterWithPanel="True"/>  
        </RelativePanel>  

        <StackPanel Grid.Row="1" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Stretch">  
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,10">  
                <AppBarButton Icon="Add" x:Name="AddButton"  
                              Foreground="{x:Bind ViewModel.AppForegroundColorBrush, Mode=OneWay}"  
                              Command="{x:Bind ViewModel.AddImageCommand}"  
                              ToolTipService.ToolTip="Add a background image including a gif"/>  
                <AppBarButton Foreground="{x:Bind ViewModel.AppForegroundColorBrush, Mode=OneWay}"  
                              Icon="Remove" x:Name="RemoveButton" Margin="10,0,0,0"  
                              Command="{x:Bind ViewModel.RemoveImageCommand}"  
                              ToolTipService.ToolTip="Remove a background image including a gif"/>  
            </StackPanel>  

            <ScrollViewer Height="400" x:Name="imageScrollview" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">  
                <ListView Width="Auto" BorderThickness="2" Name="imagelist"  
                          CanDragItems="True" AllowDrop="True" CanReorderItems="True"  
                          ToolTipService.ToolTip="Background images"  
                          ItemsSource="{x:Bind ViewModel.BackgroundImages, Mode=OneWay}"  
                          SelectedItem="{x:Bind ViewModel.SelectedBackgroundImage, Mode=TwoWay}"  
                          SelectionMode="Single"  
                          ItemTemplate="{StaticResource ImageLIstTemplate}">  
                    <ListView.ItemContainerStyle>  
                        <Style TargetType="ListViewItem">  
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>  
                        </Style>  
                    </ListView.ItemContainerStyle>  
                </ListView>  
            </ScrollViewer>  
        </StackPanel>  
    </Grid>  
</Page>
