<Page
    x:Class="appLauncher.Core.Pages.AppLoading"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:appLauncher.Core.ViewModels"
    mc:Ignorable="d"
    Background="{x:Bind ViewModel.AppBackgroundColorBrush, Mode=OneWay}">

    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                          Width="100" Height="100"
                          Foreground="{x:Bind ViewModel.AppForegroundColorBrush, Mode=OneWay}"
                          Margin="0,0,0,20"/>
            <TextBlock Text="{x:Bind ViewModel.LoadingMessage, Mode=OneWay}"
                       HorizontalAlignment="Center"
                       FontSize="20"
                       Foreground="{x:Bind ViewModel.AppForegroundColorBrush, Mode=OneWay}"
                       TextWrapping="Wrap"
                       TextAlignment="Center"/>
        </StackPanel>
    </Grid>
</Page>
