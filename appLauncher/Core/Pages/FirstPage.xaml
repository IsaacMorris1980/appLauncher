<Page  
    x:Class="appLauncher.Core.Pages.FirstPage"  
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"  
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"  
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"  
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"  
    xmlns:local="using:appLauncher.Core.Pages"  
    xmlns:viewmodels="using:appLauncher.Core.ViewModels"  
    xmlns:controls="using:Microsoft.Toolkit.Uwp.UI.Controls"   
    xmlns:models="using:appLauncher.Core.Model"  
    mc:Ignorable="d"  
    Loaded="Page_Loaded"  
    SizeChanged="Page_SizeChanged">  

    <Page.Resources>  
        <DataTemplate x:Key="NavMenuItemTemplate" x:DataType="models:NavFontIcon">  
            <StackPanel Orientation="Horizontal" Padding="12">  
                <FontIcon Glyph="{Binding Glyph}" FontFamily="{Binding FontFamily}" Margin="0,0,12,0"/>  
                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>  
            </StackPanel>  
        </DataTemplate>  

        <DataTemplate x:Key="PageIndicatorTemplate" x:DataType="models:PageIndicators">  
            <Ellipse Tag="{Binding PageNum}"  
                     Height="13"  
                     Width="13"  
                     Margin="12"  
                     Fill="{Binding IndicatorBrush}" />  
            <ToolTipService.ToolTip>  
                <ToolTip Content="{Binding ToolTip}"/>  
            </ToolTipService.ToolTip>  
        </DataTemplate>  
    </Page.Resources>  

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">  
        <SplitView x:Name="MainNavigation"  
                   DisplayMode="CompactInline"  
                   IsPaneOpen="False"  
                   CompactPaneLength="50"  
                   PointerEntered="MainNavigation_PointerEntered"  
                   PointerExited="MainNavigation_PointerExited">  
            <SplitView.Pane>  
                <Grid>  
                    <Grid.RowDefinitions>  
                        <RowDefinition Height="Auto"/>  
                        <RowDefinition Height="*"/>  
                    </Grid.RowDefinitions>  

                    <TextBox x:Name="Searching"  
                             Grid.Row="0"  
                             PlaceholderText="Search"  
                             Margin="5"  
                             Visibility="{Binding IsSearchingVisible, Mode=OneWay}"  
                             Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  
                             TextChanged="Searching_TextChanged"/>  
                    <ListView x:Name="NavMenu"  
                              Grid.Row="1"  
                              ItemsSource="{Binding NavMenuItems}"  
                              ItemTemplate="{StaticResource NavMenuItemTemplate}">  
                        <ListView.ItemContainerStyle>  
                            <Style TargetType="ListViewItem">  
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>  
                                <Setter Property="Template">  
                                    <Setter.Value>  
                                        <ControlTemplate TargetType="ListViewItem">  
                                            <ListViewItemPresenter ContentTransitions="{TemplateBinding ContentTransitions}"  
                                                                   Control.IsTemplateFocusTarget="True"                                                                    
                                                                   DisabledOpacity="{ThemeResource ListViewItemDisabledThemeOpacity}"  
                                                                   FocusVisualMargin="{TemplateBinding FocusVisualMargin}"  
                                                                   DragBackground="{ThemeResource ListViewItemDragBackground}"  
                                                                   DragForeground="{ThemeResource ListViewItemDragForeground}"  
                                                                   FocusBorderBrush="{ThemeResource ListViewItemFocusBorderBrush}"  
                                                                   HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"  
                                                                   PointerOverBackground="{ThemeResource ListViewItemPointerOverBackground}"  
                                                                   PressedBackground="{ThemeResource ListViewItemPressedBackground}"  
                                                                   ReorderHintOffset="{ThemeResource ListViewItemReorderHintOffset}"  
                                                                   SelectedBackground="{ThemeResource ListViewItemCheckPressedBackground}"  
                                                                   SelectedForeground="{ThemeResource ListViewItemCheckPressedForeground}"                                                                  
                                                                   VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}">  
                                                <Button Command="{Binding ElementName=MainNavigation, Path=DataContext.NavigateCommand}"  
                                                        CommandParameter="{Binding}"  
                                                        Style="{StaticResource TextBlockButtonStyle}"  
                                                        HorizontalAlignment="Stretch"  
                                                        VerticalAlignment="Stretch">  
                                                    <ContentPresenter/>  
                                                </Button>  
                                            </ListViewItemPresenter>  
                                        </ControlTemplate>  
                                    </Setter.Value>  
                                </Setter>  
                            </Style>  
                        </ListView.ItemContainerStyle>  
                    </ListView>  
                </Grid>  
            </SplitView.Pane>  

            <SplitView.Content>  
                <Grid x:Name="MainContentGrid">  
                    <Grid.RowDefinitions>  
                        <RowDefinition Height="*"/>  
                        <RowDefinition Height="Auto"/>  
                    </Grid.RowDefinitions>  

                    <Frame x:Name="NavFrame" Grid.Row="0"/>  

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,10">  
                        <Button Content="Previous" IsHitTestVisible="{Binding IsPrevious}" Command="{Binding PreviousPageCommand}" Margin="5"/>  
                        <ListView x:Name="listView"  
                                  ItemsSource="{Binding PageIndicators}"  
                                  ItemTemplate="{StaticResource PageIndicatorTemplate}"  
                                  SelectionChanged="listView_SelectionChanged"  
                                  SelectionMode="Single"  
                                  ScrollViewer.HorizontalScrollMode="Disabled"  
                                  ScrollViewer.VerticalScrollMode="Disabled">  
                            <ListView.ItemsPanel>  
                                <ItemsPanelTemplate>  
                                    <StackPanel Orientation="Horizontal"/>  
                                </ItemsPanelTemplate>  
                            </ListView.ItemsPanel>  
                        </ListView>  
                        <Button Content="Next" IsHitTestVisible="{Binding IsNext}" Command="{Binding NextPageCommand}" Margin="5"/>  
                    </StackPanel>  

                    <controls:InAppNotification x:Name="Inapp" VerticalAlignment="Top"/>  
                </Grid>  
            </SplitView.Content>  
        </SplitView>  
    </Grid>  
</Page>