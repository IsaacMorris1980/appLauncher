<Page
    x:Class="appLauncher.Core.Pages.CreateFolders"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:appLauncher.Core.Model"
    xmlns:viewmodels="using:appLauncher.Core.ViewModels"
    xmlns:converters="using:appLauncher.Core.Converters" 
    mc:Ignorable="d"
    Background="{x:Bind ViewModel.AppBackgroundColorBrush, Mode=OneWay}">

    <Page.Resources>
        <!-- Converters for Visibility -->
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:BooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" IsInverse="True"/>
        <!-- You can also move these to App.xaml.Resources for global access -->

        <!-- App Item Template for ListBoxes -->
        <DataTemplate x:Key="AppItemTemplate" x:DataType="models:FinalTiles">
            <Grid VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50" />
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Canvas Grid.Column="0" Background="{x:Bind LogoBrush}" Height="40" Width="40" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{x:Bind Name}"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"
                           FontSize="16"
                           TextWrapping="Wrap"
                           Foreground="{x:Bind TextBrush}"/>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <!-- Header Section -->
            <RelativePanel HorizontalAlignment="Stretch" Height="100" Margin="10" VerticalAlignment="Stretch">
                <TextBlock Text="Create Folder"
                           FontSize="36"
                           FontWeight="Bold"
                           Margin="16,20,0,16"
                           Name="titleTextBlock"
                           Foreground="{x:Bind ViewModel.AppForegroundColorBrush, Mode=OneWay}"
                           RelativePanel.AlignHorizontalCenterWithPanel="True"/>
            </RelativePanel>

            <!-- Main Content Area -->
            <ScrollViewer Height="400" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Stretch">

                    <!-- Folder Name Display (Visible after creation initiated) -->
                    <TextBlock Text="{x:Bind ViewModel.CreatedFolder.Name, Mode=OneWay}"
                               FontSize="24" FontWeight="SemiBold" Margin="0,10,0,20"
                               Foreground="{x:Bind ViewModel.AppForegroundColorBrush, Mode=OneWay}"
                               HorizontalAlignment="Center"
                               Visibility="{x:Bind ViewModel.IsFolderCreationInitiated, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <!-- App Selection Section (Visible after creation initiated) -->
                    <StackPanel Orientation="Vertical"
                                Visibility="{x:Bind ViewModel.IsFolderCreationInitiated, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Apps in Folder -->
                            <StackPanel Grid.Column="0" Orientation="Vertical">
                                <TextBlock Text="Apps in Folder:"
                                           FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"
                                           Foreground="{x:Bind ViewModel.AppForegroundColorBrush, Mode=OneWay}"/>
                                <ListBox ItemsSource="{x:Bind ViewModel.CreatedFolder.FolderApps, Mode=OneWay}"
                                         SelectedItem="{x:Bind ViewModel.SelectedAppInFolder, Mode=TwoWay}"
                                         SelectionMode="Single" Width="175" Height="200"
                                         ItemTemplate="{StaticResource AppItemTemplate}">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                            </StackPanel>

                            <!-- Add/Remove Buttons -->
                            <StackPanel Grid.Column="1" Width="100" VerticalAlignment="Center">
                                <AppBarButton Content="Add to" Margin="20" Height="50" Icon="Add"
                                              Command="{x:Bind ViewModel.AddAppToFolderCommand}"
                                              Foreground="{x:Bind ViewModel.AppForegroundColorBrush, Mode=OneWay}"
                                              Background="{x:Bind ViewModel.AppBackgroundColorBrush, Mode=OneWay}"/>
                                <AppBarButton Content="Remove from" Margin="20,0,20,0" Height="50" Icon="Remove"
                                              Command="{x:Bind ViewModel.RemoveAppFromFolderCommand}"
                                              Foreground="{x:Bind ViewModel.AppForegroundColorBrush, Mode=OneWay}"
                                              Background="{x:Bind ViewModel.AppBackgroundColorBrush, Mode=OneWay}"/>
                            </StackPanel>

                            <!-- All Available Apps -->
                            <StackPanel Grid.Column="2" Orientation="Vertical">
                                <TextBlock Text="All Apps:"
                                           FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"
                                           Foreground="{x:Bind ViewModel.AppForegroundColorBrush, Mode=OneWay}"/>
                                <ListBox SelectionMode="Single" Width="175" Height="225"
                                         ItemsSource="{x:Bind ViewModel.AllAvailableApps, Mode=OneWay}"
                                         SelectedItem="{x:Bind ViewModel.SelectedAvailableApp, Mode=TwoWay}"
                                         ItemTemplate="{StaticResource AppItemTemplate}">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Save Button -->
                    <AppBarButton x:Name="SaveButton" Icon="Save" Label="Save Folder" Margin="0,20,0,0"
                                  Command="{x:Bind ViewModel.SaveFolderCommand}"
                                  Visibility="{x:Bind ViewModel.IsFolderCreationInitiated, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  Foreground="{x:Bind ViewModel.AppForegroundColorBrush, Mode=OneWay}"
                                  Background="{x:Bind ViewModel.AppBackgroundColorBrush, Mode=OneWay}"/>

                </StackPanel>
            </ScrollViewer>
        </StackPanel>
    </Grid>
</Page>
