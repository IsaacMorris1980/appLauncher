<Page
    x:Class="appLauncher.Core.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:appLauncher.Core.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="using:appLauncher.Core.Pages"
    xmlns:helper="using:appLauncher.Core.Helpers" 
    xmlns:controls="using:Microsoft.Toolkit.Uwp.UI.Controls"
    xmlns:models="using:appLauncher.Core.Model"
    xmlns:vm="using:appLauncher.Core.PageModel"
    mc:Ignorable="d"
    Background="{x:Bind helper:SettingsHelper.totalAppSettings.AppBackgroundColorBrush}">
    <Page.DataContext>
        <vm:AboutModel />
    </Page.DataContext>
     <Grid Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
       
        <!--<controls:RotatorTile Grid.RowSpan="3" x:Name="backimage" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ItemsSource="{x:Bind helper:ImageHelper.backgroundImage}" Direction="Left" >
            <controls:RotatorTile.ItemTemplate>
                <DataTemplate x:DataType="models:PageBackgrounds">
                    <Canvas Background="{x:Bind BackImage}" />
                </DataTemplate>
            </controls:RotatorTile.ItemTemplate>
        </controls:RotatorTile>-->
       <Grid >
            <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <ScrollViewer Height="{x:Bind pages:FirstPage.navFrame.Height}"  >
                    <StackPanel Background="Transparent" >
                        
                        <TextBox Background="Transparent" BorderThickness="0" Foreground="{x:Bind helper:SettingsHelper.totalAppSettings.AppForegroundColorBrush}" HorizontalAlignment="Center" Margin="10,20,10,0" HorizontalContentAlignment="Center" IsHitTestVisible="False" Text="{Binding Title}" IsReadOnly="True" FontSize="24" FontWeight="Bold" />
                        <TextBox Background="Transparent" BorderThickness="0" Foreground="{x:Bind helper:SettingsHelper.totalAppSettings.AppForegroundColorBrush}" HorizontalAlignment="Center" Margin="10,20,10,0" HorizontalContentAlignment="Center" IsHitTestVisible="False" Text="{Binding MaintanersAndCollaborators}" IsReadOnly="True" FontSize="16" FontWeight="Bold" />
                        <ScrollViewer HorizontalContentAlignment="Center" HorizontalAlignment="Center">
                            <ListView HorizontalContentAlignment="Center" ItemsSource="{Binding Collaborators}" >
                                <ListView.ItemTemplate>
                                    <DataTemplate x:Name="ListViewTemplate" x:DataType="models:AppLinks">
                                        <HyperlinkButton Background="Transparent" RelativePanel.AlignHorizontalCenterWithPanel="True" RelativePanel.Below="titleTextBlock" BorderThickness="0" Foreground="{x:Bind helper:SettingsHelper.totalAppSettings.AppForegroundColorBrush}" HorizontalAlignment="Center" Content="{x:Bind Name}" NavigateUri="{x:Bind Link}" />
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </ScrollViewer>
                        <TextBox Background="Transparent" BorderThickness="0" Foreground="{x:Bind helper:SettingsHelper.totalAppSettings.AppForegroundColorBrush}" HorizontalAlignment="Center" Margin="10,20,10,0" HorizontalContentAlignment="Center" IsHitTestVisible="False" Text="{Binding Versions}" IsReadOnly="True" FontSize="12" FontWeight="Bold" />
                        <TextBox Background="Transparent" BorderThickness="0" Foreground="{x:Bind helper:SettingsHelper.totalAppSettings.AppForegroundColorBrush}" HorizontalAlignment="Center" Margin="10,20,10,0" HorizontalContentAlignment="Center" IsHitTestVisible="False" Text="{Binding AppInfos}" IsReadOnly="True" FontSize="16" FontWeight="Bold" />
                        <HyperlinkButton Background="Transparent" Foreground="{x:Bind helper:SettingsHelper.totalAppSettings.AppForegroundColorBrush}" HorizontalAlignment="Center" Content="{Binding Issues.Name}" NavigateUri="{Binding Issues.Link}" />
                        <HyperlinkButton Background="Transparent" Foreground="{x:Bind helper:SettingsHelper.totalAppSettings.AppForegroundColorBrush}" HorizontalAlignment="Center" Content="{Binding Latest.Name}" NavigateUri="{Binding Latest.Link}" />
                        <HyperlinkButton Background="Transparent" Foreground="{x:Bind helper:SettingsHelper.totalAppSettings.AppForegroundColorBrush}" HorizontalAlignment="Center" Content="{Binding Previous.Name}" NavigateUri="{Binding Previous.Link}" />
                    </StackPanel>
                  </ScrollViewer>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
